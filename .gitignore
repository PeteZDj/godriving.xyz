node_modules/
build/
dist/
# Anchored to the repo root on purpose. A bare `data/` matches a directory of
# that name at ANY depth, which silently excluded src/data/ and
# godriving-rn/src/data/ - the road sign dataset and the mobile app's API
# layer. The repo would not build from a clean clone and those files existed
# only on the server's disk. No root-level data/ directory exists, so anchoring
# costs nothing.
/data/
*.db
*.db-wal
*.db-shm
*.log
npm-debug.log*
.DS_Store
Thumbs.db
Desktop.ini
.cursor/
.vscode/
*.local
*.swp
*.swo
*~
.idea/

# .NET / MAUI (GoDriving.App) build artifacts
[Bb]in/
[Oo]bj/
.vs/
*.user
*.binlog
*.aab

# Keep the shippable APK tracked even though bin/ is ignored
!public/downloads/godriving.apk
config.bat
